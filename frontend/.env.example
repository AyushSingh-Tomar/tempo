# Copy to .env.local and adjust. Never commit real secrets.
# Base URL of the FastAPI backend (no trailing slash, no /api/v1 suffix).
VITE_API_BASE_URL=http://localhost:8000
# Dev-only auth token: dev-{user_id}-{role}; role in admin|project_owner|analyst|reviewer|viewer.
# Approval actions require a role with mapping:approve permission (admin/project_owner/reviewer).
# Can be changed at runtime with the "Dev identity" switcher in the header.
VITE_DEV_AUTH_TOKEN=dev-analyst1-reviewer
# Client-side upload size pre-check in bytes (server limit is authoritative).
VITE_MAX_UPLOAD_BYTES=104857600
