# Copy to backend/.env and adjust. Every value can also be set as an environment variable.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (iteration 1: SQLite via aiosqlite). Relative paths resolve from the
# directory you start uvicorn / alembic in (normally backend/).
DATABASE_URL=sqlite+aiosqlite:///./bordereaux.db
DATABASE_ECHO=false

# Local file storage root (raw uploads, cleaned/processed files, reports)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600

# Dev auth - NOT FOR PRODUCTION. Clients send "Authorization: Bearer dev-{user_id}-{role}"
# roles: admin | project_owner | analyst | reviewer | viewer
# Optional comma-separated allow-list; leave empty to accept any well-formed dev token.
AUTH_PROVIDER=dev
DEV_AUTH_TOKENS=

JOBS_MAX_CONCURRENT_PER_PROJECT=3

# Frontend dev server origins (Vite default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI layer (disabled by default so the deterministic pipeline keeps working)
# To enable it, copy this file to .env and provide a real API key / endpoint.
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_VERSION=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2000
